<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".HaWidgetApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_home_assistant"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HaCustomWidgets"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".widget.EntityStateWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.HaCustomWidgets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".dashboard.DashboardWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.HaCustomWidgets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".realtime.RealtimeNotificationListenerService"
            android:exported="true"
            android:label="@string/realtime_service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.EntityStateWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_entity_state">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/entity_state_widget_info" />
        </receiver>

        <receiver
            android:name=".dashboard.DashboardWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_dashboard">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_DELETED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/dashboard_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ThemeChangeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
